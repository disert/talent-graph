__pycache__
*.pyc
.venv
venv
# data 目录只排除运行期产物，保留 OCR 模型缓存（要烤进镜像，见 Dockerfile）。
# 必须写成 data/* + !data/paddlex_models：直接写 data 会让 docker 不再往下遍历，
# 后面的 ! 例外规则就失效了。
data/*
!data/paddlex_models
data/paddlex_models/locks
data/paddlex_models/temp
data/paddlex_models/func_ret
# 注意：.env 不再忽略——它要被烘焙进镜像（见 Dockerfile 的 COPY .env）
.git
.gitignore
*.log
Dockerfile
.dockerignore
